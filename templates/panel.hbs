{{! ApplicationV2 parts must render a single root element, hence the outer
    wrapper (verified live, 2026-08-12: three sibling .row divs threw
    "Template part must render a single HTML element").

    Encounter proposals render as real cards (templates/card-encounter.hbs,
    M7) via {{> card-encounter}}. Anything else in `queued` (no other
    subsystem builds a card yet) still dumps as JSON — "ugly is fine, ugly is
    honest" (docs/milestones/03-panel.md) — so a future propose-mode action
    is visible rather than silently dropped. }}
<div class="gm-delegate-panel-inner {{#if collapsed}}collapsed{{/if}}">
  <div class="row toggle">
    <button type="button" class="collapse-toggle" data-action="toggleCollapse">{{#if collapsed}}&#9656;{{else}}&#9662;{{/if}} GM Delegate</button>
  </div>
  <div class="row chips">
    {{#each chips}}
      <button type="button" class="chip {{#if this.active}}active{{/if}}" data-action="cycleChip" data-subsystem="{{this.key}}">
        {{this.label}} {{#if this.active}}&#9679;{{else}}&#9675;{{/if}}{{this.mode}}
      </button>
    {{/each}}
    <button type="button" class="reclaim {{#if reclaimed}}active{{/if}}" data-action="reclaim">
      {{#if reclaimed}}RECLAIMED — click to release{{else}}RECLAIM{{/if}}
    </button>
  </div>

  <div class="row trigger">
    <input type="text" name="triggerText" placeholder="three days through the Thornwood…" />
    <button type="button" data-action="ask">ask</button>
  </div>

  <div class="row queue">
    <div class="queued-cards">
      {{#each cards}}
        {{> card-encounter}}
      {{/each}}
      {{#each queued}}
        <pre class="card-stub">{{this}}</pre>
      {{/each}}
      {{#unless anyQueued}}
        <span class="empty">no queued proposals</span>
      {{/unless}}
    </div>
    <div class="undo-controls">
      <input type="number" name="undoN" value="1" min="1" />
      <button type="button" data-action="undo">undo &#9257;</button>
    </div>
  </div>
</div>
