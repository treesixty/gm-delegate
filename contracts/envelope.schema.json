{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gm-delegate.local/contracts/envelope.schema.json",
  "title": "gm-delegate wire envelope",
  "description": "NORMATIVE. Every frame on the module<->agent socket, both directions. Spec §5.6. Both processes MUST validate outbound and inbound frames against this file. Do not add message types without editing this file first.",

  "type": "object",
  "required": ["v", "type", "id", "ts", "payload"],
  "additionalProperties": false,

  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Protocol version. Mismatch means log, drop, surface once in the panel. Never guess."
    },
    "type": {
      "type": "string",
      "enum": ["HELLO", "INTENT", "RESULT", "EVENT", "POLICY_REVOKED", "UNDONE"],
      "description": "Six types. If it is not in this enum it does not exist. Unknown type means log and drop, never throw."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, generated by the sender. A RESULT MUST echo the id of the INTENT it answers. This is the only correlation mechanism; ordering is not guaranteed."
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds at send time."
    },
    "payload": { "type": "object" }
  },

  "oneOf": [
    {
      "properties": {
        "type": { "const": "HELLO" },
        "payload": { "$ref": "#/$defs/hello" }
      }
    },
    {
      "properties": {
        "type": { "const": "INTENT" },
        "payload": { "$ref": "#/$defs/intent" }
      }
    },
    {
      "properties": {
        "type": { "const": "RESULT" },
        "payload": { "$ref": "#/$defs/result" }
      }
    },
    {
      "properties": {
        "type": { "const": "EVENT" },
        "payload": { "$ref": "#/$defs/event" }
      }
    },
    {
      "properties": {
        "type": { "const": "POLICY_REVOKED" },
        "payload": { "$ref": "#/$defs/policyRevoked" }
      }
    },
    {
      "properties": {
        "type": { "const": "UNDONE" },
        "payload": { "$ref": "#/$defs/undone" }
      }
    }
  ],

  "$defs": {
    "hello": {
      "type": "object",
      "required": ["v", "role"],
      "additionalProperties": false,
      "properties": {
        "v": { "type": "integer", "const": 1 },
        "role": { "type": "string", "enum": ["module", "agent"] },
        "moduleVersion": { "type": "string" },
        "agentVersion": { "type": "string" }
      }
    },

    "intent": {
      "description": "agent -> module. Gets exactly one RESULT, always, including on rejection (§4.4).",
      "type": "object",
      "required": ["subsystem", "stage", "action", "args"],
      "additionalProperties": false,
      "properties": {
        "subsystem": {
          "type": "string",
          "enum": ["random_encounters", "loot", "npc_voice", "combat_tactics", "rules_lookup", "recap"],
          "description": "Must match SUBSYSTEMS in policy.js. §4.3."
        },
        "stage": {
          "type": "string",
          "enum": ["decide", "prompt"],
          "description": "NOT 'narrate'. §1.1 forbids it and no code path may reintroduce it."
        },
        "action": {
          "type": "string",
          "description": "Must be a key in the EXECUTORS allowlist. Unknown action means REJECTED/UNKNOWN_ACTION, never a fallback.",
          "not": {
            "enum": ["actor.hp.write", "document.delete", "macro.execute", "compendium.searchAll"]
          }
        },
        "args": { "type": "object" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "result": {
      "description": "module -> agent. A rejection is a reply, not a silence.",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["EXECUTED", "QUEUED", "REJECTED"] },
        "result": { "type": "object" },
        "reason": {
          "type": "string",
          "description": "Required when status is REJECTED. HARD_BAN | POLICY_OFF | UNKNOWN_ACTION | EXEC_FAILED: <msg>"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "REJECTED" } } },
          "then": { "required": ["status", "reason"] }
        }
      ]
    },

    "event": {
      "description": "module -> agent. Unacknowledged and droppable. Buffer the last 128 and drop the oldest; never apply backpressure to Foundry's hook loop.",
      "type": "object",
      "required": ["event", "data"],
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "enum": ["token.selected", "chat.message", "combat.turn", "scene.active", "token.moved"],
          "description": "Must match the HOOKS table in eventbus.js. §4.6."
        },
        "data": { "type": "object" }
      }
    },

    "policyRevoked": {
      "description": "module -> agent. Not advisory. On receipt the agent clears its queue and stops emitting until a HELLO round-trip. RECLAIM is sticky (§4.7).",
      "type": "object",
      "required": ["scope", "ts"],
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "enum": ["all_off", "scene", "subsystem"] },
        "subsystem": { "type": "string" },
        "ts": { "type": "integer", "minimum": 0 }
      }
    },

    "undone": {
      "description": "module -> agent. The agent MUST NOT re-narrate undone material (§4.5).",
      "type": "object",
      "required": ["ids"],
      "additionalProperties": false,
      "properties": {
        "ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },

    "provenance": {
      "description": "Foundry decided, not the model. §5.4 renders this on the card.",
      "type": "object",
      "required": ["tableId", "roll", "result"],
      "additionalProperties": false,
      "properties": {
        "tableId": { "type": "string" },
        "roll": { "type": "integer" },
        "tableDice": { "type": "string", "description": "e.g. '1d20'" },
        "result": { "type": "string", "description": "The drawn row, verbatim." },
        "quantity": { "type": "integer", "minimum": 1 },
        "quantityDice": { "type": "string", "description": "e.g. '2d4=5'. Resolved by the executor, never by the model (§5.2)." }
      }
    }
  }
}
